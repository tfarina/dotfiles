conky.config = {
--    background = true,
    update_interval = 1.5,  -- update interval in seconds
    double_buffer = true, -- use double buffering (reduces flicker, may not work for everyone)
    no_buffers = true,

    alignment = 'top_left',
    gap_x = 10,
    gap_y = 40,

    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',

    border_width = 1,

    use_xft = true,
    font = 'DejaVu Sans:size=9',

    cpu_avg_samples = 1,
    net_avg_samples = 1,

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = true,
    show_graph_scale = false,
    show_graph_range = false,

    default_color = 'white',
    color1 = '#E7C208'
}

conky.text = [[
${color1}Uptime:$color $uptime

${font DejaVu Sans:style=Bold:size=10}SYSTEM ${hr 2}$font

${color1}CPU 0:$color ${cpu cpu1}%
${color1}${cpubar cpu0 4}
${color1}CPU 1:$color ${cpu cpu2}%
${color1}${cpubar cpu1 4}

${color1}Processes:$color ${processes}
${color1}Users:$color ${user_number}

${color1}temp1:$color ${hwmon 0 temp 1}°C
${color1}Core 0:$color ${hwmon 1 temp 2}°C
${color1}Core 1:$color ${hwmon 1 temp 3}°C

${font DejaVu Sans:style=Bold:size=10}DISK ${hr 2}$font

${color1}Read:$color ${diskio_read /dev/sda} ${alignr}${color1}Write:$color ${diskio_write /dev/sda}

${font DejaVu Sans:style=Bold:size=10}MEMORY ${hr 2}$font

${color1}RAM:$color ${memperc}%
${color1}${membar 4}
${color1}Used:$color ${mem} $alignr ${color1}Total:$color ${memmax}
${color1}Available:$color ${execi 5 awk '/^MemAvailable:/ {printf "%.0f MiB", $2/1024}' /proc/meminfo} $alignr ${color1}Free:$color ${memfree}
${color1}Buffers:$color ${buffers} $alignr ${color1}Cached:$color ${cached}

${color1}SWAP:$color ${swapperc}%
${color1}${swapbar 4}
${color1}Used:$color ${swap} $alignr ${color1}Total:$color ${swapmax}
${color1}Free:$color ${swapfree}

${font DejaVu Sans:style=Bold:size=10}NETWORK ${hr 2}$font

${color1}Up:$color ${upspeedf wlx00c0a8e1f377} KiB/s ${alignr}${color1}Down:$color ${downspeedf wlx00c0a8e1f377} KiB/s
${color1}Sent:$color ${totalup wlx00c0a8e1f377} ${alignr}${color1}Received:$color ${totaldown wlx00c0a8e1f377}
]]
